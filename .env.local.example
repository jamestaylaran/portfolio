# Copy this file to .env.local and fill in your values.

# Signing key for the owner login session. Generate one with:
#   openssl rand -base64 32
SESSION_SECRET=replace_me_with_a_long_random_string

# Postgres connection string. On Vercel, create a Postgres database in your
# project (Storage → Create → Postgres) and Vercel sets this automatically.
# For local dev, paste the same connection string here.
POSTGRES_URL=postgresql://user:password@host:5432/database
